# DapurGizi Environment Configuration Example
# Copy this file to .env and fill in the actual values locally.
# NEVER commit .env to Git.
#
# PENTING: hanya SUPABASE_URL dan SUPABASE_ANON_KEY yang dipakai aplikasi.
# JANGAN menambahkan SUPABASE_SERVICE_ROLE_KEY ke file ini, ke frontend,
# atau ke paket EXE. Operasi administratif dijalankan terpisah oleh operator.

# Supabase Backend Configuration (Managed by Gabriel)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Application Runtime Configuration
APP_ENV=development
APP_HOST=localhost
APP_PORT=8000
APP_WINDOW_WIDTH=1280
APP_WINDOW_HEIGHT=800

# Waktu operasional Indonesia (dipakai dashboard & laporan)
APP_TIMEZONE=Asia/Jakarta

# Masa berlaku sesi (jam)
SESSION_TTL_HOURS=8
REMEMBER_SESSION_TTL_HOURS=168
